# QQ 开放平台机器人凭证
QQBOT_APP_ID=your_app_id
QQBOT_APP_SECRET=your_app_secret

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# AI 行为
SYSTEM_PROMPT=你是一个运行在 QQ 中的 AI 助手。请使用简体中文，回答准确、自然、简洁；除非用户明确要求详细展开，否则尽量把回复控制在 800 个中文字符以内。
MAX_HISTORY_TURNS=8
HISTORY_TTL_MINUTES=120
AI_TIMEOUT_MS=45000

# 群聊仅在 @机器人 时回复
GROUP_REQUIRE_MENTION=true

# 健康检查
HEALTH_HOST=0.0.0.0
HEALTH_PORT=3000
