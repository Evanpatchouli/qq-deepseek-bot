{
  "name": "qq-deepseek-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QQ Open Platform AI bot backend powered by DeepSeek",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "menu:setup": "node scripts/setup-menu.js",
    "test": "node --test \"test/*.test.js\"",
    "db:backup": "node scripts/database.js backup",
    "db:restore": "node scripts/database.js restore",
    "db:verify": "node scripts/database.js verify"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "openai": "7.10.0"
  }
}
